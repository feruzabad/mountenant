{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/feruzabad/mountenant/configs/users.schema.json",
  "title": "Mountenant users.json",
  "description": "Users allowed to log in. Removing a user disables them; their jobs are kept until they expire. Reloaded on SIGHUP.",
  "type": "array",
  "$defs": {
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActiveJobs": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "maxTotalJobs": {
          "type": "integer",
          "minimum": 1,
          "default": 50
        },
        "maxNzbBytes": {
          "type": "integer",
          "minimum": 1,
          "default": 33554432,
          "description": "Limit on the decompressed NZB; capped by jobs.maxNzbBytesHardCap."
        },
        "maxDownloadBytesPerDay": {
          "type": "integer",
          "minimum": 1,
          "default": 107374182400,
          "description": "Per UTC day."
        },
        "maxConcurrentDownloads": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        }
      }
    }
  },
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "username",
      "passwordHash"
    ],
    "properties": {
      "username": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]{3,32}$"
      },
      "passwordHash": {
        "type": "string",
        "pattern": "^\\$argon2id\\$v=19\\$m=[0-9]+,t=[0-9]+,p=[0-9]+\\$[A-Za-z0-9+/]+\\$[A-Za-z0-9+/]+$",
        "description": "Output of `mountenant hash-password`. Plaintext passwords are rejected."
      },
      "quota": {
        "$ref": "#/$defs/quota",
        "description": "Overrides individual fields of defaults.quota."
      },
      "disabled": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
